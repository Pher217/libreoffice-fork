<?xml version="1.0" encoding="UTF-8"?>
<!-- OfficeLabs WebViewPanel UI - minimal container for CEF browser -->
<interface domain="officelabs">
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkBox" id="WebViewPanel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="vexpand">True</property>
    <property name="hexpand">True</property>
    <!-- CEF browser is embedded via SystemChildWindow filling this container -->
    <child>
      <object class="GtkDrawingArea" id="cef_container">
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <property name="vexpand">True</property>
        <property name="hexpand">True</property>
      </object>
    </child>
    <!-- Shown instead of the browser when CEF fails to start (project#368) -->
    <child>
      <object class="GtkLabel" id="cef_error">
        <property name="visible">False</property>
        <property name="can-focus">False</property>
        <property name="vexpand">True</property>
        <property name="hexpand">True</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="label" translatable="yes" context="webviewpanel|cef_error">The assistant could not start. Restart OfficeLabs; if it persists, contact support.</property>
        <property name="justify">center</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">30</property>
      </object>
    </child>
  </object>
</interface>
