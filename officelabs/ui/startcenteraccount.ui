<?xml version="1.0" encoding="UTF-8"?>
<!-- OfficeLabs Start Center sign-in entry (project#418): label, sublabel, one button -->
<interface domain="officelabs">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="StartCenterAccount">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">6</property>
    <property name="margin-bottom">6</property>
    <property name="spacing">3</property>
    <child>
      <object class="GtkSeparator" id="account_separator">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="account_label">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <property name="max-width-chars">26</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="account_sublabel">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <property name="max-width-chars">26</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="account_button">
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <property name="label" translatable="yes" context="startcenteraccount|account_button">Sign in</property>
        <property name="receives-default">True</property>
        <property name="margin-top">3</property>
      </object>
    </child>
  </object>
</interface>
